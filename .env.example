# All AI settings are optional - the app works fully without any of them.
# Copy to .env and fill in what you want to use.

# OpenAI (image clean-up + analysis)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VISION_MODEL=gpt-4o-mini

# Google Gemini (image clean-up + analysis)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-2.5-flash

# OpenRouter (any image-output / vision model it hosts)
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Local Ollama (analysis only - needs a vision model, e.g. `ollama pull qwen2.5vl:7b`)
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# App
# DATA_DIR=./data
# MAX_UPLOAD_MB=40
# RASTER_PX_PER_MM=12
