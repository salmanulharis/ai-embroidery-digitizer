# --- Accounts (required) ---
# The first Super Admin, created at startup if no account has this email. It adds all
# other accounts in the app (Account menu > Manage users). Production: GitHub secrets.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional: sign in with this username instead of the email. Set only here (applied at
# every start); the app cannot change it.
SUPER_ADMIN_USERNAME=
# Encrypts each user's saved AI keys. Set once and keep it (a random key file is created
# in DATA_DIR when empty).
APP_SECRET_KEY=
# "Keep me signed in" lasts this many days.
SESSION_DAYS=30

# --- AI (optional - the app works fully without it) ---
# Each user saves their own keys in the app (AI settings); those are stored encrypted
# per account. Keys set here are server-wide defaults that every signed-in user can use.
#
# Models: leave empty to pick a suitable current model automatically from the
# provider's live model list. Set one to pin a specific model.

# Google Gemini - picture clean-up + advice (has a free tier)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_VISION_MODEL=

# OpenAI - picture clean-up (GPT Image) + advice
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_VISION_MODEL=

# OpenRouter - one key for many models
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_VISION_MODEL=

# Anthropic Claude - advice and stitch checks (no picture clean-up)
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=

# Ollama on this computer - free, local advice (install a vision model: `ollama pull qwen3-vl`)
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=

# Any OpenAI-compatible service (LM Studio, vLLM, Groq, Together, ...)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_VISION_MODEL=
CUSTOM_AI_IMAGE_MODEL=

# Allow AI addresses on private/local networks (needed for Ollama / LM Studio).
# Set to 0 on public deployments so users cannot make the server call internal addresses.
AI_ALLOW_PRIVATE_ENDPOINTS=1
AI_TIMEOUT_S=120

# App
# DATA_DIR=./data
# MAX_UPLOAD_MB=40
# RASTER_PX_PER_MM=12
# RASTER_MAX_SIDE_PX=2000
# Model for the optional rembg photo cut-out (pip install rembg). Keep a model whose
# licence allows your use: rembg's own default (bria-rmbg) needs a paid BRIA licence
# for commercial use.
# REMBG_MODEL=isnet-general-use
